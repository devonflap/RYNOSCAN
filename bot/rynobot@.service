[Unit]
Description=RynoBot %i (dry-run trading bot for RynoScan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=/etc/rynobot.env
ExecStart=/usr/bin/env node bot/run.mjs --bot %i
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
